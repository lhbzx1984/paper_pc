# ===== 论文评审系统 环境变量配置 =====
# 复制此文件为 .env 并填入你的配置
# cp .env.example .env

# 大模型 API Key（必填）
# 支持 DeepSeek、OpenAI、通义千问等兼容 OpenAI API 的模型
LLM_API_KEY=your-api-key-here

# 大模型 API 地址
LLM_BASE_URL=https://api.deepseek.com/v1

# 模型名称
LLM_MODEL=deepseek-chat

# 端口配置（可选，留空使用默认值）
# 前端访问端口，默认 80；若 80 被占用可改为 8080 等
FRONTEND_PORT=80
# 后端 API 端口，默认 8000
BACKEND_PORT=8000
